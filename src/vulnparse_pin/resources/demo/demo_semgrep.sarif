{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep",
          "semanticVersion": "1.92.0",
          "rules": [
            {
              "id": "python.django.security.audit.xss.template-unescaped",
              "name": "UnescapedTemplateOutput",
              "shortDescription": {
                "text": "Potential Reflected XSS via Unescaped Template Rendering"
              },
              "fullDescription": {
                "text": "Static analysis detected unescaped user-supplied parameter passed to HTML response helper."
              },
              "properties": {
                "tags": ["security", "CWE-79"],
                "security-severity": "9.1"
              }
            }
          ]
        }
      },
      "properties": {
        "targetUri": "https://edge-api.acme.test"
      },
      "results": [
        {
          "ruleId": "python.django.security.audit.xss.template-unescaped",
          "level": "error",
          "message": {
            "text": "Static taint flow from request.args to HTML template without autoescape."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/edge_api/views.py"
                },
                "region": {
                  "startLine": 88
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
