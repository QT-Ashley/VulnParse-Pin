{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Trivy",
          "semanticVersion": "0.56.2",
          "rules": [
            {
              "id": "CVE-2021-44228",
              "name": "Log4Shell",
              "shortDescription": {
                "text": "Apache Log4j2 Remote Code Execution (log4j-core 2.14.1)"
              },
              "fullDescription": {
                "text": "Apache Log4j2 JNDI features allow remote code execution via untrusted LDAP/RMI endpoints."
              },
              "properties": {
                "tags": ["vulnerability", "CVE-2021-44228", "CWE-917"],
                "security-severity": "10.0"
              }
            },
            {
              "id": "CVE-2023-26136",
              "name": "ToughCookieProtoPollution",
              "shortDescription": {
                "text": "tough-cookie Prototype Pollution in CookieJar"
              },
              "fullDescription": {
                "text": "Versions of tough-cookie prior to 4.1.3 are vulnerable to Prototype Pollution via CookieJar."
              },
              "properties": {
                "tags": ["vulnerability", "CVE-2023-26136", "GHSA-jchw-253m-c5p7", "CWE-1321"],
                "security-severity": "9.8"
              }
            }
          ]
        }
      },
      "properties": {
        "imageName": "ghcr.io/acme/edge-api"
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "endTimeUtc": "2026-11-01T12:00:00Z"
        }
      ],
      "results": [
        {
          "ruleId": "CVE-2021-44228",
          "level": "error",
          "message": {
            "text": "Package org.apache.logging.log4j:log4j-core@2.14.1 is vulnerable to CVE-2021-44228; upgrade to 2.17.1."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/libs/log4j-core-2.14.1.jar"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "pkgID": "pkg:maven/org.apache.logging.log4j/log4j-core@2.14.1",
            "purl": "pkg:maven/org.apache.logging.log4j/log4j-core@2.14.1",
            "cves": ["CVE-2021-44228"]
          }
        },
        {
          "ruleId": "CVE-2023-26136",
          "level": "error",
          "message": {
            "text": "Package tough-cookie@4.1.2 is vulnerable to CVE-2023-26136 (GHSA-jchw-253m-c5p7); upgrade to 4.1.3."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/package-lock.json"
                },
                "region": {
                  "startLine": 42
                }
              }
            }
          ],
          "properties": {
            "pkgID": "pkg:npm/tough-cookie@4.1.2",
            "purl": "pkg:npm/tough-cookie@4.1.2",
            "cves": ["CVE-2023-26136"],
            "ghsa_ids": ["GHSA-jchw-253m-c5p7"]
          }
        }
      ]
    }
  ]
}
