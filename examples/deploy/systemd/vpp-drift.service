# Hardened systemd oneshot service for VulnParse-Pin KEV/EPSS drift checks
# Install:
#   sudo useradd --system --home-dir /var/lib/vulnparse-pin --shell /usr/sbin/nologin vpp
#   sudo install -d -o vpp -g vpp -m 0700 /var/lib/vulnparse-pin /var/cache/vulnparse-pin /var/log/vulnparse-pin
#   sudo install -d -o root -g vpp -m 0750 /etc/vulnparse-pin
#   # Create /etc/vulnparse-pin/vpp.env (chmod 0640, root:vpp) with:
#   #   VP_FEED_CACHE_HMAC_KEY=<32-byte-secret>
#   #   VP_SQLITE_HMAC_KEY=<32-byte-secret>
#   #   XDG_DATA_HOME=/var/cache/vulnparse-pin/data
#   #   XDG_CONFIG_HOME=/etc/vulnparse-pin/config
#   #   XDG_CACHE_HOME=/var/cache/vulnparse-pin/xdg
#   sudo cp examples/deploy/systemd/vpp-drift.service /etc/systemd/system/
#   sudo cp examples/deploy/systemd/vpp-drift.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now vpp-drift.timer

[Unit]
Description=VulnParse-Pin Threat-Intel Sync and Stale-Assumption Drift Check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=vpp
Group=vpp
WorkingDirectory=/var/lib/vulnparse-pin
EnvironmentFile=/etc/vulnparse-pin/vpp.env
ExecStart=/usr/local/bin/scheduled-kev-drift-check.sh

# Exit code 2 indicates stale-assumption policy drift; leave it as non-zero so
# systemd triggers failure alerting / journald status, or add `SuccessExitStatus=2`
# if your external monitor parses drift_report.json instead.
Restart=no

# Filesystem & Privilege Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/vulnparse-pin /var/cache/vulnparse-pin /var/log/vulnparse-pin

[Install]
WantedBy=multi-user.target
